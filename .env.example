# ─────────────────────────────────────────────────────────
# Appointment Management System — Environment Variables
# Copy this file to .env and fill in real values.
# ─────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_DB=appointment_db           # Database name
POSTGRES_USER=postgres               # Database user
POSTGRES_PASSWORD=changeme           # Database password (CHANGE IN PRODUCTION!)
POSTGRES_PORT=5432                   # Host-mapped PostgreSQL port

# ── ASP.NET Core ──────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development   # Development | Production
API_PORT=5000                        # Host-mapped API port

# ── JWT Authentication ────────────────────────────────────
JWT_KEY=your-secret-key-at-least-32-characters-long   # HMAC signing key (CHANGE!)
JWT_ISSUER=AppointmentSystem         # Token issuer claim
JWT_AUDIENCE=AppointmentSystem       # Token audience claim

# ── Email (SMTP via MailKit) ──────────────────────────────
SMTP_HOST=smtp.example.com           # SMTP server hostname
SMTP_PORT=587                        # SMTP port (587 for STARTTLS)
SMTP_USER=user@example.com           # SMTP authentication username
SMTP_PASSWORD=changeme               # SMTP authentication password
EMAIL_FROM=noreply@example.com       # From address on outgoing emails

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000   # Comma-separated allowed origins

# ── Frontend ─────────────────────────────────────────────
CLIENT_PORT=3000                     # Host-mapped frontend port
